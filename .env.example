# Copy this file to `.env` on the server (cp .env.example .env) and fill it in.
# docker-compose reads it via `env_file: .env`. Never commit the real .env.

# Host port the app is published on (the container always listens on 8080
# internally). Pick any free port; keep the tailscale serve target in sync.
APP_PORT=8081

# Shared sync secret. Generate a long random string, e.g.:
#   openssl rand -base64 32
# The SAME value is entered on both phones (Settings → server token).
SYNC_TOKEN=

# USDA FoodData Central API key — used by the server-side nutrition proxy
# from Phase 3 onward. Free signup: https://fdc.nal.usda.gov/api-key-signup.html
# Safe to leave empty until the nutrition phase ships.
USDA_API_KEY=
